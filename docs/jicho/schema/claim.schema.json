{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JICHO Claim",
  "type": "object",
  "required": [
    "id",
    "subject",
    "predicate",
    "source",
    "status",
    "asserted_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "object": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "object_entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "lead",
        "corroborated_allegation",
        "documented_discrepancy",
        "investigative_finding",
        "official_finding",
        "sanction_or_debarment",
        "conviction",
        "cleared_reversed_corrected"
      ]
    },
    "directness": {
      "enum": [
        "direct",
        "inferred",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "coverage_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "asserted_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "locator"
      ],
      "properties": {
        "type": {
          "enum": [
            "primary_document",
            "official_record",
            "human_source",
            "physical_observation",
            "authenticated_dataset",
            "secondary_reporting",
            "other"
          ]
        },
        "locator": {
          "type": "string"
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "independence_family": {
      "type": [
        "string",
        "null"
      ]
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "corroborates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}